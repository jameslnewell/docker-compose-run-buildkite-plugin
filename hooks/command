#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

# Buildkite treats lines beginning with ---, +++ or ~~~ as log-group headers.
# The agent sources this hook, so `set -x` runs a few shell-nesting levels deep
# and bash replicates PS4's first character once per level — the default '+ '
# can become '+++ ', which Buildkite would parse as a group header (each traced
# command becomes its own section, leaving our intended groups empty). An empty
# PS4 emits no prefix at all (bash does not fall back to a default), so the
# traced command itself starts the line — and every command we trace begins
# with `docker`/`buildkite-agent`, never a marker.
PS4=''

SERVICE="${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SERVICE}"
PROJECT="docker-compose-run-buildkite-plugin-${BUILDKITE_JOB_ID}"

mapfile -t FILES < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_FILE")
FILE_ARGS=()
for f in "${FILES[@]}"; do
  FILE_ARGS+=(-f "$f")
done

COMPOSE_PROGRESS_ARGS=()
if docker compose --help 2>&1 | grep -qE '^\s+--progress(\s|$)'; then
  COMPOSE_PROGRESS_ARGS=(--progress=plain)
fi

# Feature-detect flags that vary across Compose versions.
PULL_SUPPORTS_INCLUDE_DEPS=false
if docker compose pull --help 2>&1 | grep -qE '^\s+--include-deps(\s|$)'; then
  PULL_SUPPORTS_INCLUDE_DEPS=true
fi
UP_SUPPORTS_PULL=false
if docker compose up --help 2>&1 | grep -qE '^\s+--pull(\s|$)'; then
  UP_SUPPORTS_PULL=true
fi
RUN_SUPPORTS_PULL=false
if docker compose run --help 2>&1 | grep -qE '^\s+--pull(\s|$)'; then
  RUN_SUPPORTS_PULL=true
fi

# Pull only the target service and its dependency tree, when Compose can scope it.
# Older Compose lacks --include-deps — there we skip this phase and let later steps pull.
if [[ "$PULL_SUPPORTS_INCLUDE_DEPS" == "true" ]]; then
  echo "--- :docker: pulling"
  set -x
  docker compose "${COMPOSE_PROGRESS_ARGS[@]}" -p "$PROJECT" "${FILE_ARGS[@]}" pull --include-deps "$SERVICE"
  { set +x; } 2>/dev/null
fi

# Once the pull phase has fetched the images, tell the later `up`/`run` not to pull
# again. Gated on the pull having happened (and each flag existing); `--pull never`
# would otherwise be unsafe — `up --scale=0` never pulls the target image itself.
UP_PRELOADED_ARGS=()
if [[ "$PULL_SUPPORTS_INCLUDE_DEPS" == "true" && "$UP_SUPPORTS_PULL" == "true" ]]; then
  UP_PRELOADED_ARGS=(--pull never)
fi
RUN_PRELOADED_ARGS=()
if [[ "$PULL_SUPPORTS_INCLUDE_DEPS" == "true" && "$RUN_SUPPORTS_PULL" == "true" ]]; then
  RUN_PRELOADED_ARGS=(--pull never)
fi

# Start only the dependencies: scaling the target to 0 brings up its depends_on tree
# without starting the target itself.
#
# We deliberately omit `--wait` here. Compose before v2.16.0 has a bug where `up --wait`
# combined with `--scale <service>=0` hangs forever, waiting on the scaled-to-0 target
# that is never started (docker/compose#9149, fixed in v2.16.0). Once our lowest
# supported Compose version is >= v2.16.0 we can add `--wait` back to block on the
# dependency tree becoming healthy.
echo "--- :docker: upping"
set -x
docker compose "${COMPOSE_PROGRESS_ARGS[@]}" -p "$PROJECT" "${FILE_ARGS[@]}" up --detach "${UP_PRELOADED_ARGS[@]}" --scale "${SERVICE}=0" "$SERVICE"
{ set +x; } 2>/dev/null

echo "+++ :docker: running"

RUN_ARGS=()
workdir="${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_WORKDIR:-}"
[[ -n "$workdir" ]] && RUN_ARGS+=(--workdir "$workdir")

entrypoint=""
if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENTRYPOINT+set}" == "set" ]]; then
  entrypoint="${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENTRYPOINT}"
  RUN_ARGS+=(--entrypoint "$entrypoint")
fi

mapfile -t ENVS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENVIRONMENT")
for e in "${ENVS[@]}"; do
  RUN_ARGS+=(-e "$e")
done

if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_PROPAGATE_AWS:-false}" == "true" ]]; then
  RUN_ARGS+=(-e "AWS_REGION")
  RUN_ARGS+=(-e "AWS_DEFAULT_REGION")
  RUN_ARGS+=(-e "AWS_ACCESS_KEY_ID")
  RUN_ARGS+=(-e "AWS_SECRET_ACCESS_KEY")
  RUN_ARGS+=(-e "AWS_SESSION_TOKEN")
fi

if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_PROPAGATE_BUILDKITE_ENVIRONMENT:-false}" == "true" ]]; then
  while IFS='=' read -r key _; do
    if [[ "$key" == "CI" || "$key" == "BUILDKITE" || "$key" == BUILDKITE_* ]]; then
      RUN_ARGS+=(-e "$key")
    fi
  done < <(env)
fi

mapfile -t VOLUMES < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_VOLUMES")
for v in "${VOLUMES[@]}"; do
  if [[ "$v" == *:* ]]; then
    host="${v%%:*}"
    rest="${v#*:}"
    if [[ "$host" == ./* ]] || [[ "$host" == . ]]; then
      host="$(pwd)/${host#./}"
    fi
    v="${host}:${rest}"
  fi
  RUN_ARGS+=(-v "$v")
done

if [[ -n "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_COMMAND:-}" && -z "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_COMMAND_0:-}" ]]; then
  echo "+++ Error: The command option must be an array, not a string. Use command: ['arg1', 'arg2']."
  exit 1
fi
mapfile -t CMD_ITEMS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_COMMAND")
has_step_commands=false
[[ -n "${BUILDKITE_COMMAND:-}" ]] && has_step_commands=true
has_plugin_commands=false
[[ ${#CMD_ITEMS[@]} -gt 0 ]] && has_plugin_commands=true

if [[ "$has_step_commands" == "true" && "$has_plugin_commands" == "true" ]]; then
  echo "+++ Error: Cannot specify both step commands and plugin commands. Move commands to the step or to the plugin 'command' option, not both."
  exit 1
fi

# Determine shell (only applies to step commands)
SHELL_ARGS=()
shell_enabled=true
shell_explicitly_set=false
if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL:-}" =~ ^(false|off|0)$ ]]; then
  shell_enabled=false
elif [[ -n "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL_0:-}" ]]; then
  mapfile -t SHELL_ARGS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL")
  shell_explicitly_set=true
elif [[ -n "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL:-}" ]]; then
  echo "+++ Error: The shell option must be an array or false, not a string."
  exit 1
else
  SHELL_ARGS=("/bin/sh" "-e" "-c")
fi

# Any entrypoint (even "") suppresses shell wrapping — matches official buildkite docker plugin.
[[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENTRYPOINT+set}" == "set" ]] && shell_enabled=false

# Error if shell was explicitly set as an array but entrypoint suppresses it.
if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENTRYPOINT+set}" == "set" && "$shell_explicitly_set" == "true" ]]; then
  echo "+++ Error: The shell option has no effect when entrypoint is set — entrypoint suppresses shell wrapping."
  exit 1
fi

CMD_ARGS=()
if [[ "$has_step_commands" == "true" ]]; then
  if [[ "$shell_enabled" == "true" ]]; then
    CMD_ARGS+=("${SHELL_ARGS[@]}" "$BUILDKITE_COMMAND")
  else
    CMD_ARGS+=("$BUILDKITE_COMMAND")
  fi
elif [[ "$has_plugin_commands" == "true" ]]; then
  # Plugin commands are passed directly as container CMD args — no shell wrapper
  CMD_ARGS+=("${CMD_ITEMS[@]}")
fi

set -x
docker compose "${COMPOSE_PROGRESS_ARGS[@]}" -p "$PROJECT" "${FILE_ARGS[@]}" run \
  "${RUN_PRELOADED_ARGS[@]}" \
  --rm \
  "${RUN_ARGS[@]}" \
  "$SERVICE" \
  "${CMD_ARGS[@]}"
{ set +x; } 2>/dev/null
