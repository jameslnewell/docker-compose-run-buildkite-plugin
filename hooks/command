#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

# Buildkite treats lines beginning with ---, +++ or ~~~ as log-group headers.
# The agent sources this hook, so `set -x` runs a few shell-nesting levels deep
# and bash replicates PS4's first character once per level — the default '+ '
# can become '+++ ', which Buildkite would parse as a group header (each traced
# command becomes its own section, leaving our intended groups empty). An empty
# PS4 emits no prefix at all (bash does not fall back to a default), so the
# traced command itself starts the line — and every command we trace begins
# with `docker`/`buildkite-agent`, never a marker.
PS4=''

SERVICE="${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SERVICE}"
PROJECT="docker-compose-run-buildkite-plugin-${BUILDKITE_JOB_ID}"
# Named the way the docker-run plugin names its container, so a post-command hook
# can find it. pre-exit removes it by this name.
CONTAINER="docker-compose-run-buildkite-plugin-${BUILDKITE_JOB_ID}"

# Array expansions here are written "${arr[@]+"${arr[@]}"}" rather than plain
# "${arr[@]}". Under `set -u` bash only expands an empty array to nothing from 4.4
# onwards; before that the expansion is an "unbound variable" error that kills the
# hook. Most of these arrays are legitimately empty on the ordinary path — no
# `file`, none of `workdir`/`entrypoint`/`environment`/`volumes`, a Compose
# advertising none of the optional flags — so plain expansions make the plugin
# unusable on bash 3.2 (what macOS ships) and 4.2 (Amazon Linux 2, CentOS 7).
# `${arr[@]+...}` substitutes only when the array is set, which every bash since
# 3.x handles.
#
# Applied to every array expansion in this hook, including ones that cannot be
# empty today, so no later edit has to re-derive which is which. It does not
# change the emitted argv: the inner quotes keep each element exactly one word,
# elements containing spaces or newlines included.
FILE_ARGS=()
if plugin_read_list_into_result "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_FILE"; then
  for f in "${result[@]+"${result[@]}"}"; do
    FILE_ARGS+=(-f "$f")
  done
fi

# Checked before anything is pulled or started, so a malformed entry fails in
# seconds rather than after the command has run.
COPY_OUT=()
if plugin_read_list_into_result "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_COPY_OUT"; then
  for entry in "${result[@]+"${result[@]}"}"; do
    if [[ "$entry" != *:* || "$entry" == *:*:* || "$entry" == :* || "$entry" == *: ]]; then
      echo "+++ Error: Each copy-out entry must be \"<from>:<to>\", a path in the container and a path in the job's working directory. Got \"${entry}\"."
      exit 1
    fi
    to="${entry#*:}"
    to="${to#./}"
    while [[ "$to" == */ ]]; do
      to="${to%/}"
    done
    # Whatever is at `to` is removed to make way for the copy, so `to` may not
    # name the working directory itself or anything outside it.
    if [[ -z "$to" || "$to" == /* || "/${to}/" == */./* || "/${to}/" == */../* ]]; then
      echo "+++ Error: The <to> of a copy-out entry must be a path inside the job's working directory. Got \"${entry}\"."
      echo "The copy replaces whatever is at <to>, so it cannot be absolute, contain \"..\", or be the working directory itself."
      exit 1
    fi
    COPY_OUT+=("${entry%%:*}:${to}")
  done
fi

COMPOSE_PROGRESS_ARGS=()
if docker compose --help 2>&1 | grep -qE '^\s+--progress(\s|$)'; then
  COMPOSE_PROGRESS_ARGS=(--progress=plain)
fi

# Feature-detect flags that vary across Compose versions.
PULL_SUPPORTS_INCLUDE_DEPS=false
if docker compose pull --help 2>&1 | grep -qE '^\s+--include-deps(\s|$)'; then
  PULL_SUPPORTS_INCLUDE_DEPS=true
fi
UP_SUPPORTS_PULL=false
if docker compose up --help 2>&1 | grep -qE '^\s+--pull(\s|$)'; then
  UP_SUPPORTS_PULL=true
fi
RUN_SUPPORTS_PULL=false
if docker compose run --help 2>&1 | grep -qE '^\s+--pull(\s|$)'; then
  RUN_SUPPORTS_PULL=true
fi

# Pull only the target service and its dependency tree, when Compose can scope it.
# Older Compose lacks --include-deps — there we skip this phase and let later steps pull.
if [[ "$PULL_SUPPORTS_INCLUDE_DEPS" == "true" ]]; then
  echo "--- :docker: pulling"
  set -x
  docker compose "${COMPOSE_PROGRESS_ARGS[@]+"${COMPOSE_PROGRESS_ARGS[@]}"}" -p "$PROJECT" "${FILE_ARGS[@]+"${FILE_ARGS[@]}"}" pull --include-deps "$SERVICE"
  { set +x; } 2>/dev/null
fi

# Once the pull phase has fetched the images, tell the later `up`/`run` not to pull
# again. Gated on the pull having happened (and each flag existing); `--pull never`
# would otherwise be unsafe — `up --scale=0` never pulls the target image itself.
UP_PRELOADED_ARGS=()
if [[ "$PULL_SUPPORTS_INCLUDE_DEPS" == "true" && "$UP_SUPPORTS_PULL" == "true" ]]; then
  UP_PRELOADED_ARGS=(--pull never)
fi
RUN_PRELOADED_ARGS=()
if [[ "$PULL_SUPPORTS_INCLUDE_DEPS" == "true" && "$RUN_SUPPORTS_PULL" == "true" ]]; then
  RUN_PRELOADED_ARGS=(--pull never)
fi

# Start only the dependencies: scaling the target to 0 brings up its depends_on tree
# without starting the target itself.
#
# We deliberately omit `--wait` here. Compose before v2.16.0 has a bug where `up --wait`
# combined with `--scale <service>=0` hangs forever, waiting on the scaled-to-0 target
# that is never started (docker/compose#9149, fixed in v2.16.0). Once our lowest
# supported Compose version is >= v2.16.0 we can add `--wait` back to block on the
# dependency tree becoming healthy.
echo "--- :docker: upping"
set -x
docker compose "${COMPOSE_PROGRESS_ARGS[@]+"${COMPOSE_PROGRESS_ARGS[@]}"}" -p "$PROJECT" "${FILE_ARGS[@]+"${FILE_ARGS[@]}"}" up --detach "${UP_PRELOADED_ARGS[@]+"${UP_PRELOADED_ARGS[@]}"}" --scale "${SERVICE}=0" "$SERVICE"
{ set +x; } 2>/dev/null

echo "+++ :docker: running"

# `rm: false` keeps the stopped run container until pre-exit, so a post-command
# hook can `docker cp` output out of it — the lifetime docker-run gives its own.
# `copy-out` needs the stopped container too, so it also drops `--rm`; the hook
# removes the container itself once the copy is done.
RM_ARGS=()
if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_RM:-true}" == "true" && ${#COPY_OUT[@]} -eq 0 ]]; then
  RM_ARGS=(--rm)
fi

RUN_ARGS=()
workdir="${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_WORKDIR:-}"
[[ -n "$workdir" ]] && RUN_ARGS+=(--workdir "$workdir")

entrypoint=""
if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENTRYPOINT+set}" == "set" ]]; then
  entrypoint="${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENTRYPOINT}"
  RUN_ARGS+=(--entrypoint "$entrypoint")
fi

if plugin_read_list_into_result "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENVIRONMENT"; then
  for e in "${result[@]+"${result[@]}"}"; do
    RUN_ARGS+=(-e "$e")
  done
fi

if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_PROPAGATE_AWS:-false}" == "true" ]]; then
  RUN_ARGS+=(-e "AWS_REGION")
  RUN_ARGS+=(-e "AWS_DEFAULT_REGION")
  RUN_ARGS+=(-e "AWS_ACCESS_KEY_ID")
  RUN_ARGS+=(-e "AWS_SECRET_ACCESS_KEY")
  RUN_ARGS+=(-e "AWS_SESSION_TOKEN")
fi

if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_PROPAGATE_BUILDKITE_ENVIRONMENT:-false}" == "true" ]]; then
  # `compgen -e`, not `env`: `env` prints NAME=VALUE records separated by
  # newlines, so a variable whose value contains a newline (a commit message,
  # a multi-line BUILDKITE_COMMAND) makes each of its continuation lines look
  # like another record — and a line such as `BUILDKITE_FOO=1` inside a value
  # would be forwarded as if `BUILDKITE_FOO` were a real variable. `compgen -e`
  # lists the names of exported variables only, and a name can never contain a
  # newline, so one line is always exactly one name.
  while read -r key; do
    if [[ "$key" == "CI" || "$key" == "BUILDKITE" || "$key" == BUILDKITE_* ]]; then
      RUN_ARGS+=(-e "$key")
    fi
  done < <(compgen -e)
fi

if plugin_read_list_into_result "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_VOLUMES"; then
  for v in "${result[@]+"${result[@]}"}"; do
    if [[ "$v" == *:* ]]; then
      host="${v%%:*}"
      rest="${v#*:}"
      if [[ "$host" == ./* ]] || [[ "$host" == . ]]; then
        host="$(pwd)/${host#./}"
      fi
      v="${host}:${rest}"
    fi
    RUN_ARGS+=(-v "$v")
  done
fi

if [[ -n "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_COMMAND:-}" && -z "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_COMMAND_0:-}" ]]; then
  echo "+++ Error: The command option must be an array, not a string. Use command: ['arg1', 'arg2']."
  exit 1
fi
CMD_ITEMS=()
if plugin_read_list_into_result "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_COMMAND"; then
  CMD_ITEMS=("${result[@]+"${result[@]}"}")
fi
has_step_commands=false
[[ -n "${BUILDKITE_COMMAND:-}" ]] && has_step_commands=true
has_plugin_commands=false
[[ ${#CMD_ITEMS[@]} -gt 0 ]] && has_plugin_commands=true

if [[ "$has_step_commands" == "true" && "$has_plugin_commands" == "true" ]]; then
  echo "+++ Error: Cannot specify both step commands and plugin commands. Move commands to the step or to the plugin 'command' option, not both."
  exit 1
fi

# Shell wrapping resolves the same way as the official buildkite docker plugin:
# off unless something turns it on. The step having a command of its own turns it
# on, because BUILDKITE_COMMAND is a script that needs a shell to interpret it.
# Naming a shell explicitly also turns it on — and that applies to the plugin's
# own `command` too, which is how a multi-line script is handed to it.
SHELL_ARGS=()
shell_disabled=true
[[ "$has_step_commands" == "true" ]] && shell_disabled=false

# Any entrypoint (even "") turns wrapping back off: the entrypoint now decides how
# the remaining arguments are interpreted. An explicitly named shell below can
# still turn it back on — the official plugin resolves the two in that order.
[[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_ENTRYPOINT+set}" == "set" ]] && shell_disabled=true

if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL:-}" =~ ^(false|off|0)$ ]]; then
  shell_disabled=true
elif [[ -n "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL_0:-}" ]]; then
  plugin_read_list_into_result "BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL"
  SHELL_ARGS=("${result[@]+"${result[@]}"}")
  shell_disabled=false
elif [[ -n "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_SHELL:-}" ]]; then
  echo "+++ Error: The shell option must be an array or false, not a string."
  exit 1
fi

if [[ "$shell_disabled" == "false" && ${#SHELL_ARGS[@]} -eq 0 ]]; then
  SHELL_ARGS=("/bin/sh" "-e" "-c")
fi

CMD_ARGS=()
# Only prepend the shell when there is something for it to run. A shell with no
# script operand is worse than no shell at all — `sh -c` exits with "-c requires
# an argument" — and with neither a step command nor a plugin command the
# service's own command is what should run. The official plugin emits the bare
# shell here and the container fails; this is a deliberate divergence.
if [[ "$has_step_commands" == "true" || "$has_plugin_commands" == "true" ]]; then
  if [[ "$shell_disabled" == "false" ]]; then
    CMD_ARGS+=("${SHELL_ARGS[@]+"${SHELL_ARGS[@]}"}")
  fi
fi

if [[ "$has_step_commands" == "true" ]]; then
  CMD_ARGS+=("$BUILDKITE_COMMAND")
elif [[ "$has_plugin_commands" == "true" ]]; then
  CMD_ARGS+=("${CMD_ITEMS[@]+"${CMD_ITEMS[@]}"}")
fi

# The status is kept rather than left to `set -e`, because a command that fails
# has usually still written the output `copy-out` is there to collect.
run_status=0
set -x
docker compose "${COMPOSE_PROGRESS_ARGS[@]+"${COMPOSE_PROGRESS_ARGS[@]}"}" -p "$PROJECT" "${FILE_ARGS[@]+"${FILE_ARGS[@]}"}" run \
  "${RUN_PRELOADED_ARGS[@]+"${RUN_PRELOADED_ARGS[@]}"}" \
  --name "$CONTAINER" \
  "${RM_ARGS[@]+"${RM_ARGS[@]}"}" \
  "${RUN_ARGS[@]+"${RUN_ARGS[@]}"}" \
  "$SERVICE" \
  "${CMD_ARGS[@]+"${CMD_ARGS[@]}"}" || { run_status=$?; } 2>/dev/null
{ set +x; } 2>/dev/null

# The copy happens here rather than in a post-command hook so that every
# post-command hook sees the output: the agent runs those in reverse plugin order
# from v4, which would put this plugin's after an artifact upload listed below it.
copy_failed=false
if [[ ${#COPY_OUT[@]} -gt 0 ]]; then
  echo "--- :docker: copying out"
  # A run that failed before creating its container left nothing to copy.
  if container_workdir="$(docker container inspect --format '{{.Config.WorkingDir}}' "$CONTAINER")"; then
    for entry in "${COPY_OUT[@]+"${COPY_OUT[@]}"}"; do
      # `docker cp` resolves a relative container path against /, not against the
      # directory the command ran in.
      from="${entry%%:*}"
      [[ "$from" == /* ]] || from="${container_workdir%/}/${from#./}"
      to="${entry#*:}"
      dest="$(pwd)/${to}"

      # `docker cp` can't be asked whether a path exists, and how it words a
      # missing one varies between Docker versions. Asking for the path as a tar
      # stream answers it: a byte only arrives when the path is there. None
      # arrives when the container has gone or its filesystem can't be read
      # either, so the path is only called missing if / does answer. If it
      # doesn't, the copy below fails with docker's own error.
      #
      # `--follow-link` here and on the copy: without it a `from` that is a
      # symlink is copied as the link, which points nowhere useful on the agent.
      if [[ -z "$(docker cp --follow-link "${CONTAINER}:${from}" - 2>/dev/null | head -c 1)" \
        && -n "$(docker cp "${CONTAINER}:/" - 2>/dev/null | head -c 1)" ]]; then
        echo "Skipped ${from}: not found in the run container"
        continue
      fi

      # Copied to a scratch directory and moved into place, because `docker cp`
      # into an existing directory nests the copy inside it. Removing `to` first
      # instead would delete the source when the checkout is mounted over the
      # container's working directory, where `from` and `to` are one directory.
      scratch="$(mktemp -d "${TMPDIR:-/tmp}/docker-compose-run-buildkite-plugin.XXXXXX")"
      copy_status=0
      set -x
      docker cp --follow-link "${CONTAINER}:${from}" "${scratch}/copy" || { copy_status=$?; } 2>/dev/null
      { set +x; } 2>/dev/null

      # A `to` that already holds the same files is left alone. That is the mounted
      # checkout again: the container wrote `to` itself, as root unless told
      # otherwise, and an agent that isn't root could not remove it.
      if [[ "$copy_status" -eq 0 ]] && diff -r "${scratch}/copy" "$dest" >/dev/null 2>&1; then
        rm -rf "$scratch"
        echo "Skipped ${from}: ${to} already holds the same files"
        continue
      fi

      if [[ "$copy_status" -eq 0 ]]; then
        { mkdir -p "$(dirname "$dest")" && rm -rf "$dest" && mv "${scratch}/copy" "$dest"; } || copy_status=$?
      fi
      rm -rf "$scratch"

      if [[ "$copy_status" -ne 0 ]]; then
        echo "^^^ +++"
        echo "Error: could not copy ${from} out of the run container to ${to}"
        copy_failed=true
        continue
      fi
      echo "Copied ${from} to ${to}"
    done

    # pre-exit removes the container if this doesn't, or never gets to run.
    if [[ "${BUILDKITE_PLUGIN_DOCKER_COMPOSE_RUN_RM:-true}" == "true" ]]; then
      set -x
      docker rm --force --volumes "$CONTAINER" || true
      { set +x; } 2>/dev/null
    fi
  else
    echo "^^^ +++"
    echo "Error: there is no run container to copy out of"
    copy_failed=true
  fi
fi

if [[ "$run_status" -ne 0 ]]; then
  exit "$run_status"
fi
if [[ "$copy_failed" == "true" ]]; then
  exit 1
fi
